// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "Debug get (key: 10)",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/lsm",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["get", "10"],
    "build": {
      "label": "Build lsm for get debugging",
      "command": "cargo",
      "args": ["build", "--bin", "lsm"],
      "env": {},
      "cwd": "$ZED_WORKTREE_ROOT",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": [],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
  {
    "adapter": "CodeLLDB",
    "label": "Run bin lsm (package: lsm)",
    "build": {
      "label": "Run $ZED_CUSTOM_RUST_BIN_KIND $ZED_CUSTOM_RUST_BIN_NAME (package: $ZED_CUSTOM_RUST_PACKAGE)",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "$ZED_CUSTOM_RUST_PACKAGE",
        "--$ZED_CUSTOM_RUST_BIN_KIND",
        "$ZED_CUSTOM_RUST_BIN_NAME",
        "$ZED_CUSTOM_RUST_BIN_REQUIRED_FEATURES_FLAG",
        "$ZED_CUSTOM_RUST_BIN_REQUIRED_FEATURES",
      ],
      "env": {},
      "cwd": "$ZED_CUSTOM_RUST_MANIFEST_DIRNAME",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": ["rust-main"],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
]
